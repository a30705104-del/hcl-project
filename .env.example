# ==============================================================================
# INDUSTRIAL DIGITAL TWIN - ENVIRONMENT CONFIGURATION
# ==============================================================================

# MQTT Broker (HiveMQ Cloud or Local Broker)
MQTT_BROKER=your-cluster-url.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password
MQTT_TLS=true
MQTT_CLIENT_ID=digital-twin-backend-MTR-001

# SQLite Database
DATABASE_URL=sqlite:///./industrial_twin.db

# Machine Target
MACHINE_ID=MTR-001

# Simulation Settings
SIMULATION_INTERVAL_SEC=1.0
SAMPLING_RATE_HZ=1000

# Server Settings
API_HOST=0.0.0.0
API_PORT=8000
